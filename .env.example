# Copy to .env for local dev. In production set these as Cloudflare Worker
# secrets/vars (`wrangler secret put WEB3FORMS_ACCESS_KEY`).

# Web3Forms access key — one free account per client, leads go to their inbox.
# Get it at https://web3forms.com (enter the client's email, copy the key).
WEB3FORMS_ACCESS_KEY=

# Keystatic Cloud runs auth for the /keystatic admin in production. No key is
# needed here; set the project in src/config/site.ts + keystatic.config.ts.
# For local editing without Keystatic Cloud, see SETUP.md (local storage mode).
