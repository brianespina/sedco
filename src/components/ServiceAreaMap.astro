---
/**
 * Service-area graphic for the homepage "where we work" section.
 *
 * The guide (Part 3, Homepage) makes this optional: "embed a service-area map
 * graphic — not a Google pin, since there is no storefront." Until the client
 * supplies a real coverage map this renders as a caption card over a decorative
 * background. It deliberately shows no pins or boundaries: inventing locations
 * on a map is a factual claim we cannot make. Swapping in a real coverage map
 * is documented in SETUP.md.
 */
import { Image } from 'astro:assets';
import { site } from '@config/site';
import { images } from '@lib/images';
---

<div class="map-card">
  <Image
    class="map-card__bg"
    src={images.serviceAreaMap.src}
    alt=""
    widths={[600, 1000]}
    sizes="(max-width: 900px) 100vw, 560px"
    loading="lazy"
    aria-hidden="true"
  />
  <div class="map-card__overlay"></div>

  <div class="map-card__body">
    <p class="map-card__lead">Serving all of {site.business.county}</p>
    <p class="map-card__sub">
      Based in {site.business.locality}, {site.business.region} — our technicians come to you.
    </p>
  </div>
</div>

<style>
  .map-card {
    position: relative;
    border-radius: var(--r-card-lg);
    overflow: hidden;
    min-height: 360px;
    box-shadow: 0 22px 50px rgba(15, 58, 99, 0.22);
    isolation: isolate;
  }
  .map-card__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .map-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgba(15, 58, 99, 0.88), rgba(28, 95, 164, 0.8));
    z-index: -1;
  }
  .map-card__body {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--on-dark-badge);
    padding: 1.875rem;
  }
  .map-card__lead {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.25rem;
    color: #fff;
  }
  .map-card__sub {
    font-size: 0.875rem;
    margin-top: 0.625rem;
    max-width: 290px;
  }
</style>
