---
/**
 * BLOG INDEX — design Blog.dc.html: featured post, then a card grid.
 * Posts are Keystatic-managed (src/content/blog).
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { paths } from '@config/site';
import { images } from '@lib/images';

import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import HeroCtas from '@components/HeroCtas.astro';
import CtaSection from '@components/CtaSection.astro';
import PageSchema from '@components/schema/PageSchema.astro';

const title = 'Plumbing Tips & Local Guides | Sedco Plumbing Blog';
const description =
  'Practical plumbing advice for El Cajon and East County homeowners — hard water, slab leaks, water heaters, and local costs. Call [PHONE].';
const path = paths.blog;

const crumbs = [{ name: 'Home', href: paths.home }, { name: 'Blog' }];

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const [featured, ...rest] = posts;

const dateFormat = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<BaseLayout title={title} description={description} path={path} crumbs={crumbs}>
  <Fragment slot="head">
    <PageSchema type="Blog" name={title} description={description} path={path} />
  </Fragment>

  <Hero
    variant="center"
    image={images.heroGeneral}
    badge="East County plumbing know-how"
    heading="Plumbing Advice for East County Homes"
    intro="Local, practical answers from the crew that works on these houses every day — hard water, slab leaks, aging pipe, and what things actually cost in San Diego County."
  >
    <HeroCtas slot="cta" center />
  </Hero>

  {
    posts.length === 0 ? (
      <section class="section">
        <div class="container">
          <p class="empty-note">
            <span class="ph-chip">NO POSTS YET</span>
            Publish the first two posts from the content guide's Part 8 calendar through the
            <a href="/keystatic"> Keystatic admin</a>, and they will appear here automatically.
          </p>
        </div>
      </section>
    ) : (
      <>
        <section class="section">
          <div class="container">
            <a class="featured" href={paths.post(featured.id)}>
              <div class="featured__media">
                <Image
                  src={featured.data.featuredImage ?? images.blogDefault.src}
                  alt={featured.data.featuredImageAlt || images.blogDefault.alt}
                  widths={[480, 900]}
                  sizes="(max-width: 900px) 100vw, 560px"
                  loading="eager"
                />
                <span class="featured__pill">Featured</span>
              </div>
              <div class="featured__body">
                <span class="cat-pill">{featured.data.category}</span>
                <h2>{featured.data.title}</h2>
                <p>{featured.data.excerpt}</p>
                <span class="meta">
                  {dateFormat.format(featured.data.publishDate)} · {featured.data.author}
                </span>
                <span class="card__more" aria-hidden="true">
                  Read more →
                </span>
              </div>
            </a>
          </div>
        </section>

        {rest.length > 0 && (
          <section class="section section--tight">
            <div class="container">
              <h2 class="all-heading">All Articles</h2>
              <ul class="grid grid--3 post-grid" role="list">
                {rest.map((post) => (
                  <li>
                    <a class="card post-card" href={paths.post(post.id)}>
                      <span class="post-card__bar" aria-hidden="true" />
                      <span class="cat-pill">{post.data.category}</span>
                      <h3>{post.data.title}</h3>
                      <p>{post.data.excerpt}</p>
                      <span class="meta">{dateFormat.format(post.data.publishDate)}</span>
                      <span class="card__more" aria-hidden="true">
                        Read more →
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )}
      </>
    )
  }

  <CtaSection
    variant="dark"
    heading="Have a Plumbing Question We Have Not Covered?"
    body="Call Sedco Plumbing at [PHONE] and ask. We would rather explain your options over the phone than sell you a visit you do not need."
  />
</BaseLayout>

<style>
  .empty-note {
    background: var(--ph-bg);
    border: 1px dashed var(--ph-border);
    color: var(--ph-text);
    border-radius: var(--r-card);
    padding: 1.125rem 1.25rem;
    font-size: var(--fs-sm);
    line-height: 1.6;
    max-width: var(--measure-prose);
    margin-inline: auto;
  }

  .featured {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--r-card-lg);
    overflow: hidden;
    transition:
      border-color var(--t-med),
      box-shadow var(--t-med);
  }
  .featured:hover {
    border-color: var(--brand-primary);
    box-shadow: var(--sh-card-hover);
  }
  .featured__media {
    position: relative;
    height: 100%;
    min-height: 300px;
  }
  .featured__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .featured__pill {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: var(--accent);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.375rem 0.75rem;
    border-radius: var(--r-pill);
  }
  .featured__body {
    padding: 2rem 2.25rem 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .featured__body h2 {
    font-size: var(--fs-h2-sm);
  }
  .featured__body p {
    color: var(--text-soft);
    font-size: var(--fs-prose);
    line-height: 1.6;
  }

  .cat-pill {
    align-self: flex-start;
    background: var(--tint);
    color: var(--brand-primary);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.3125rem 0.625rem;
    border-radius: var(--r-pill);
  }
  .meta {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .all-heading {
    margin-bottom: 1.75rem;
  }
  .post-grid {
    list-style: none;
    padding: 0;
  }
  .post-grid > li {
    display: flex;
  }
  .post-card {
    width: 100%;
    padding-top: 1.875rem;
  }
  .post-card__bar {
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: linear-gradient(90deg, var(--brand-primary), var(--cyan));
  }

  @media (max-width: 900px) {
    .featured {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .featured__body {
      padding: 1.75rem;
    }
  }
</style>
