---
/**
 * REVIEWS — guide Part 3 "Reviews", design Reviews.dc.html (masonry cards).
 *
 * No Review or AggregateRating markup: the guide (Part 7.1) permits it only for
 * genuine first-party reviews collected on the site, never for reviews copied
 * from another platform. These are curated from the client's Yelp and
 * Foursquare profiles (src/config/reviews.ts), so the markup stays off.
 *
 * Each card is tagged with the city the work was done in once that is known —
 * the guide asks reviews to be grouped or tagged by city so visitors see proof
 * from their own area. Cities are unset until the client maps them.
 */
import { paths, getCity } from '@config/site';
import { reviews } from '@config/reviews';
import { isPlaceholder } from '@lib/tokens';
import { site } from '@config/site';
import { images } from '@lib/images';

import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import HeroCtas from '@components/HeroCtas.astro';
import CtaSection from '@components/CtaSection.astro';
import PageSchema from '@components/schema/PageSchema.astro';

const title = 'Sedco Plumbing Reviews | El Cajon & San Diego County';
const description =
  'Read reviews from Sedco Plumbing customers across El Cajon, La Mesa, Santee and San Diego County. Licensed, upfront-priced plumbing. Call [PHONE].';
const path = paths.reviews;

const crumbs = [{ name: 'Home', href: paths.home }, { name: 'Reviews' }];

const reviewLink = site.profiles.googleReview;
const reviewLinkReady = !isPlaceholder(reviewLink) && reviewLink.length > 0;
---

<BaseLayout title={title} description={description} path={path} crumbs={crumbs}>
  <Fragment slot="head">
    <PageSchema type="WebPage" name={title} description={description} path={path} />
  </Fragment>

  <Hero
    variant="center"
    image={images.heroGeneral}
    badge="What your neighbors say"
    heading="What Your Neighbors Say About Sedco Plumbing"
    intro="Nothing means more to us than the word of the families and businesses we serve. Here is what customers across El Cajon, La Mesa, Santee, and the rest of San Diego County have to say about working with us."
  >
    <HeroCtas slot="cta" center />
  </Hero>

  <section class="section">
    <div class="container">
      <ul class="masonry" role="list">
        {
          reviews.map((review) => {
            const city = review.city ? getCity(review.city) : null;
            return (
              <li class="review">
                {review.rating && (
                  <div class="stars" aria-label={`${review.rating} out of 5 stars`}>
                    {'★'.repeat(review.rating)}
                  </div>
                )}
                <p>“{review.quote}”</p>
                <div class="review__author">
                  <span class="avatar" aria-hidden="true">
                    {review.name.charAt(0)}
                  </span>
                  <span>
                    <strong>{review.name}</strong>
                    <span class="review__detail">
                      {city ? `${review.service} — ${city.name}` : review.service}
                    </span>
                  </span>
                </div>
                <p class="review__source">via {review.source}</p>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="ask-card">
        <div class="side-card">
          <h2>Had a Great Experience?</h2>
          <p class="card-copy">
            Reviews that mention your city and the service we performed help your neighbors find us.
            If we earned it, we would be grateful for a review on Google.
          </p>
          {
            /*
             * The guide asks for a "direct Google review link" button here. It
             * renders once profiles.googleReview is set in src/config/site.ts;
             * until then the section stands without it rather than printing a
             * note to the visitor. `npm run verify` reports the missing link.
             */
            reviewLinkReady && (
              <a class="btn btn--primary" href={reviewLink} rel="noopener">
                Leave a Google review
              </a>
            )
          }
          <p class="card-copy">
            While you are here: browse <a href={paths.servicesHub}>our plumbing services</a> or <a
              href={paths.contact}>request a service call</a
            >.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CtaSection
    heading="Ready to See for Yourself?"
    body="Call Sedco Plumbing at [PHONE] or request service online, and let us show you why East County keeps recommending us."
  />
</BaseLayout>

<style>
  .masonry {
    columns: 3;
    column-gap: 1.375rem;
    list-style: none;
    padding: 0;
  }
  .review {
    break-inside: avoid;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    padding: 1.5rem;
    margin-bottom: 1.375rem;
    box-shadow: var(--sh-card);
  }
  .review p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-soft);
    margin-top: 0.75rem;
  }
  .stars {
    color: var(--star);
    letter-spacing: 2px;
  }
  .review__author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.125rem;
  }
  .review__author > span:last-child {
    display: flex;
    flex-direction: column;
  }
  .review__author strong {
    font-size: 0.875rem;
    color: var(--brand-deep);
  }
  .review__detail {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  .review__source {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 0.75rem;
  }
  .avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--grad-chip);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 800;
    flex-shrink: 0;
  }

  .ask-card {
    max-width: var(--measure-prose);
    margin-inline: auto;
  }
  .card-copy {
    font-size: 0.9375rem;
    color: var(--text-soft);
    line-height: 1.6;
    margin-block: 0.75rem 1.125rem;
  }

  @media (max-width: 900px) {
    .masonry {
      columns: 2;
    }
  }
  @media (max-width: 620px) {
    .masonry {
      columns: 1;
    }
  }
</style>
